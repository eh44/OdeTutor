@* File: Client/Pages/TutorWorkspace.razor *@
@page "/tutor/{SelectedModuleId}"
@using Shared
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container mt-4">
    <h3>CS5620 ODE Tutor</h3>
    
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">Current Problem</div>
        <div class="card-body">
            <p>$$ @CurrentProblemStatement $$</p>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">Workspace</div>
        <div class="card-body">
            @foreach (var interaction in InteractionLog)
            {
                <div class="mb-3">
                    <div class="p-2 bg-light border rounded mb-1">
                        <strong>Your Step:</strong> $$ @interaction.StudentStep $$
                    </div>
                    <div class="p-2 text-white rounded @(interaction.IsCorrect ? "bg-success" : "bg-warning text-dark")">
                        <strong>Feedback:</strong> @interaction.AiFeedback
                    </div>
                </div>
            }
            @if (IsLoading)
            {
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(CurrentInput))
            {
                <div class="mb-3 p-3 border rounded bg-light">
                    <strong>Preview:</strong> 
                    <span @key="CurrentInput">$$ @CurrentInput $$</span>
                </div>
            }
            @if (!IsProblemSolved)
            {
                <div class="input-group mb-3">
                    <input type="text" class="form-control" @bind="CurrentInput" @bind:event="oninput" placeholder="Type your next step in LaTeX..." />
                    <button class="btn btn-primary" @onclick="SubmitStep" disabled="@IsLoading">Submit</button>
                </div>
            }
            else
            {
                <div class="alert alert-success text-center mt-4 p-4">
                    <h3>🎉 Problem Solved!</h3>
                    <p>Excellent work mastering this differential equation.</p>
                    <div class="mt-3">
                        <button class="btn btn-primary mx-2" @onclick="LoadNewProblem">Try Another Problem</button>
                        <button class="btn btn-outline-secondary mx-2" @onclick="GoHome">Return to Modules</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // 1. Capture the module ID from the URL
    [Parameter]
    public string SelectedModuleId { get; set; } = "separable"; 

    private string CurrentProblemStatement = string.Empty;
    private string CurrentInput = string.Empty;
    private bool IsLoading = false;
    private List<StepInteraction> InteractionLog = new();
    // Add this state variable at the top of your @code block
    private bool IsProblemSolved = false;

    // 1. Refactor OnParametersSet to use a helper method
    protected override void OnParametersSet()
    {
        LoadNewProblem();
    }

    // 2. The new helper method that resets the UI and picks a new problem
    private void LoadNewProblem()
    {
        InteractionLog.Clear();
        CurrentInput = string.Empty;
        IsProblemSolved = false; // Reset the success state!

        var random = new Random();

        // (Paste your existing massive if/else block with the textbook problems here)
        if (SelectedModuleId == "separable")
        {
            var problems = new[]
            {
                "\\frac{dy}{dx} = \\frac{x}{y}, \\quad y(0)=2",
                "\\frac{dy}{dx} = 3x^2 y, \\quad y(0)=1",
                "x\\frac{dy}{dx} = y^2 - y, \\quad y(1)=2",
                "\\frac{dy}{dx} = e^{x-y}, \\quad y(0)=0",
                "(x^2+1)\\frac{dy}{dx} = xy, \\quad y(1)=1",
                "\\frac{dy}{dx} = y \\cos(x), \\quad y(0)=1",
                "\\frac{dy}{dx} = \\frac{x^2}{y(1+x^3)}",
                "\\frac{dy}{dx} = \\frac{y^2 + 1}{xy}",
                "\\frac{dy}{dx} = x \\sqrt{1-y^2}",
                "\\frac{dy}{dx} = y^2 \\sin(x)"
            };
            CurrentProblemStatement = problems[random.Next(problems.Length)];
        }
        else if (SelectedModuleId == "linear")
        {
            var problems = new[]
            {
                "\\frac{dy}{dx} + 2y = e^{-x}",
                "x\\frac{dy}{dx} + 2y = x^3, \\quad y(1)=0",
                "\\frac{dy}{dx} + y = \\sin(x)",
                "x\\frac{dy}{dx} - y = x^2 \\sin(x)",
                "\\frac{dy}{dx} + (\\tan x)y = \\cos^2 x",
                "(1+x^2)\\frac{dy}{dx} + 2xy = \\frac{1}{1+x^2}",
                "x^2 \\frac{dy}{dx} + xy = 1",
                "\\frac{dy}{dx} + \\frac{2}{x}y = \\frac{\\cos x}{x^2}",
                "\\frac{dy}{dx} - 3y = 6",
                "x \\frac{dy}{dx} + (1+x)y = e^{-x}"
            };
            CurrentProblemStatement = problems[random.Next(problems.Length)];
        }
        else if (SelectedModuleId == "substitution")
        {
            var problems = new[]
            {
                "\\frac{dy}{dx} = \\frac{y^2 + x^2}{xy}",
                "\\frac{dy}{dx} = -\\frac{x^2+y^2}{x^2}",
                "\\frac{dy}{dx} = \\frac{y}{x} + e^{y/x}",
                "x \\frac{dy}{dx} = y + \\sqrt{x^2+y^2}",
                "x \\frac{dy}{dx} = y + x \\tan\\left(\\frac{y}{x}\\right)",
                "\\frac{dy}{dx} = \\frac{x+y}{x}",
                "\\frac{dy}{dx} = \\frac{y-x}{x}",
                "\\frac{dy}{dx} = \\frac{2xy}{x^2 - y^2}",
                "\\frac{dy}{dx} = \\frac{y}{x} + \\left(\\frac{y}{x}\\right)^2",
                "x^2 \\frac{dy}{dx} = y^2 + xy"
            };
            CurrentProblemStatement = problems[random.Next(problems.Length)];
        }
        else
        {
            CurrentProblemStatement = "Unknown Module";
        }
        StateHasChanged();
        _ = Task.Delay(50).ContinueWith(_ => JS.InvokeVoidAsync("typesetMath"));
    }

    // 3. The Home button logic
    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
    // Changed from OnInitialized to OnParametersSet

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("typesetMath");
    }

   private async Task SubmitStep()
{
    if (string.IsNullOrWhiteSpace(CurrentInput)) return;

    IsLoading = true;
    string stepToSubmit = CurrentInput;
    CurrentInput = string.Empty;

    var request = new TutorRequestDto
    {
        ModuleId = SelectedModuleId, 
        OriginalProblem = CurrentProblemStatement,
        StudentNewStep = stepToSubmit,
        ConversationHistory = InteractionLog
    };

    try
    {
        var response = await Http.PostAsJsonAsync("api/tutor/evaluate", request);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<TutorResponseDto>();
            if (result != null)
            {
                InteractionLog.Add(new StepInteraction
                {
                    StudentStep = stepToSubmit,
                    AiFeedback = result.LlmFeedback,
                    IsCorrect = result.IsCorrectDirection
                });
                if (result.IsProblemComplete)
                {
                    IsProblemSolved = true;
                }
            }
        }
        else
        {
            string errorText = await response.Content.ReadAsStringAsync();
            InteractionLog.Add(new StepInteraction
            {
                StudentStep = stepToSubmit,
                AiFeedback = $"⚠️ Backend Error ({response.StatusCode}): {errorText}",
                IsCorrect = false
            });
        }
    }
    catch (Exception ex)
    {
        InteractionLog.Add(new StepInteraction
        {
            StudentStep = stepToSubmit,
            AiFeedback = $"⚠️ Connection Error: {ex.Message}",
            IsCorrect = false
        });
    }
    finally
    {
        // 1. Turn off the loading spinner
        IsLoading = false;
        
        // 2. Force Blazor to draw the new chat bubbles onto the screen right now
        StateHasChanged(); 
    }

    // 3. Wait 50 milliseconds for the browser to physically paint the HTML
    await Task.Delay(50); 
    
    // 4. Command MathJax to scan the newly painted HTML and format the LaTeX!
    await JS.InvokeVoidAsync("typesetMath"); 
}
    private async Task RequestHint()
    {
        // Simulate the student asking for help
        CurrentInput = "I am completely stuck. Can you give me a hint on what to do next?";
        await SubmitStep();
    }
    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitStep();
        }
    }
}